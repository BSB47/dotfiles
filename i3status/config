###############################################################################
# ceerious i3 status config
# see "man i3status" for documentation.
#
# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!
###############################################################################

general {
    interval 		= 1
    colors 			= true
    color_good      = '#88b090'
    color_degraded  = '#ccdc90'
    color_bad       = '#e89393'
    output_format = "i3bar"
}

order += "read_file spotify"
order += "volume master"
order += "cpu_usage"
order += "memory"
order += "tztime local"

run_watch DHCP {
    pidfile = "/var/run/dhclient*.pid"
}

tztime local {
    format = "%a %e %b %Y   %l:%M"
}

load {
    format = "%1min"
}

memory {
    format = "mem  %percentage_used"
}
cpu_usage {
    format = "CPU  %usage"
}

volume master {
    format = "  %volume"
    format_muted = " "
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

read_file spotify {
    format = "  %content"
    path = "~/spotify.log"
}
